#!/bin/sh
# Launcher for a dev checkout (no install needed). Symlink it into a
# directory on your PATH:  ln -s "$PWD/bin/untis" ~/.local/bin/untis
# Alternatively install the package: pipx install . (see README).
set -e
ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
    echo "untis: no virtualenv at $ROOT/.venv - see README (Installation)" >&2
    exit 1
fi
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m untis "$@"
