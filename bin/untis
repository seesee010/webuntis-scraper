#!/bin/sh
# Launcher for the WebUntis scraper. Symlink it into a directory on your
# PATH, e.g.:  ln -s "$PWD/bin/untis" ~/.local/bin/untis
set -e
ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
    echo "untis: no virtualenv at $ROOT/.venv - see README (Installation)" >&2
    exit 1
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m src "$@"
